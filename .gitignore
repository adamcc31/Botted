# Python cache
__pycache__/
*.py[cod]
*$py.class
venv/
.env

# Binary Data Files (Large)
*.parquet
*.h5
*.feather
*.pkl

# Strategy Logs & Telemetry
logs/*.log
logs/*.csv
tmp_tokens.txt

# Large Dataset Folders
data/
raw_data/
processed_data/
results/

# VS Code / OS files
.vscode/
.DS_Store
Thumbs.db

#example project
example_project/*

# other file
dataset/
models/*
!models/alpha_v1/
plugin/
tmp/

# ─── Slingger V6 ML Pipeline ─────────────────────────────────
# Allow the entire slingger/ directory including model and dataset
# Model is small (~400KB) and safe to track in git
!slingger/
!slingger/**
# Re-exclude only very large data artifacts if they appear
# slingger/models/*.pkl is intentionally INCLUDED (V6 production model)
